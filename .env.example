# ---------------------------------------------------------------------------
# Copy this file to `.env` on the server and fill in the values.
# `server.js` loads `.env` automatically at startup.
# ---------------------------------------------------------------------------

# Port is normally injected by cPanel/Passenger. Only set it for local runs.
PORT=3000
NODE_ENV=production

# --- Supabase: server-side (never sent to the browser) ---------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses row level security. Never prefix with VITE_,
# never import into client code, never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase: browser-side (inlined at BUILD time, so set before `npm run build`) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- AI explanations (optional) --------------------------------------------
# OpenAI-compatible chat-completions endpoint used when no custom provider key
# is configured in the admin panel.
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
